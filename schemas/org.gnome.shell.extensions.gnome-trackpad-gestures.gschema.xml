<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.gnome-trackpad-gestures" path="/org/gnome/shell/extensions/gnome-trackpad-gestures/">
    <key name="swipe-gain" type="d">
      <default>1.0</default>
      <summary>Swipe gain multiplier</summary>
    </key>
    <key name="pixels-per-step" type="i">
      <default>140</default>
      <summary>Gesture distance per window step</summary>
    </key>
    <key name="long-swipe-duration-ms" type="i">
      <default>220</default>
      <summary>Duration threshold between short and long swipe</summary>
    </key>
    <key name="preview-scale" type="i">
      <default>100</default>
      <summary>Preview size percentage</summary>
    </key>
    <key name="four-finger-tap-notifications" type="b">
      <default>true</default>
      <summary>4-finger tap opens notification list</summary>
    </key>
    <key name="four-finger-swipe-down-show-desktop" type="b">
      <default>true</default>
      <summary>4-finger swipe down shows desktop</summary>
    </key>
    <key name="respect-gnome-window-switcher" type="b">
      <default>true</default>
      <summary>Follow GNOME window switcher current-workspace-only setting</summary>
    </key>
    <key name="fallback-current-workspace-only" type="b">
      <default>true</default>
      <summary>Fallback filter to current workspace when GNOME setting is unavailable</summary>
    </key>
  </schema>
</schemalist>
